<?xml version="1.0" encoding="UTF-8" ?>
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0 https://maven.apache.org/xsd/build-cache-config-1.2.0.xsd">
    <configuration>
        <enabled>true</enabled>
        <hashAlgorithm>XXH64</hashAlgorithm>
        <local>
            <maxBuildsCached>3</maxBuildsCached>
        </local>

<!-- The cache could be configured to autocorrect metadata (most notably MANIFEST.MF Implementation-Version).
     The correction requires copying and repacking archive entries and adds overhead. If the metadata state
     is not relevant for the build, consider disabling it (off by default):-->
        <projectVersioning adjustMetaInf="false"/>
    </configuration>
    <input>
        <global>
            <!--  If not defined, default glob is "*"  -->
            <glob> {*.java,*.groovy,*.yaml,*.yml,*.xml,*.properties,*.sh,*.bat,*.sql,*.ps1,*.cmd} </glob>
        </global>
    </input>
</cache>